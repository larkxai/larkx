{
  "name": "larkx",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source durable execution engine for on-device AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "turbo run build && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "pnpm exec changeset version && node scripts/sync-sdk-version.mjs && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm exec changeset publish"
  },
  "devDependencies": {
    "@larkxai/agent": "workspace:*",
    "@larkxai/cactus": "workspace:*",
    "@larkxai/core": "workspace:*",
    "@larkxai/node": "workspace:*",
    "@larkxai/protocol": "workspace:*",
    "@larkxai/react-native": "workspace:*",
    "@larkxai/storage-memory": "workspace:*",
    "@larkxai/storage-sqlite": "workspace:*",
    "@larkxai/telemetry": "workspace:*",
    "@larkxai/testing": "workspace:*",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}

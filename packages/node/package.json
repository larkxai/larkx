{
  "name": "@larkxai/node",
  "version": "0.2.0",
  "private": true,
  "description": "Internal Node.js host for the shared C++ runtime. Not a published SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "native",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/bundle-sdk-types.mjs dist/index.d.ts",
    "prepack": "node scripts/vendor-native.mjs && node scripts/prepare-publish.mjs strip",
    "postpack": "node scripts/prepare-publish.mjs restore",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@larkxai/host": "workspace:*",
    "@larkxai/protocol": "workspace:*",
    "tsup": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larkxai/larkx.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/larkxai/larkx/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/larkxai/larkx/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

{
  "name": "@larkxai/telemetry",
  "version": "0.1.2",
  "description": "Optional metadata-only exporter from a LarkX journal to LarkX Cloud.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@larkxai/core": "workspace:*",
    "@larkxai/protocol": "workspace:*",
    "@larkxai/storage-sqlite": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larkxai/larkx.git",
    "directory": "packages/telemetry"
  },
  "homepage": "https://github.com/larkxai/larkx/tree/main/packages/telemetry#readme",
  "bugs": {
    "url": "https://github.com/larkxai/larkx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@larkxai/cactus",
  "version": "0.1.2",
  "description": "Optional Cactus model adapter. The C++ runtime does not import this package.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "ios": "./dist/index.js",
      "android": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "react-native": "./dist/adapter.js",
      "ios": "./dist/adapter.js",
      "android": "./dist/adapter.js",
      "import": "./dist/adapter.js",
      "require": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@larkxai/protocol": "workspace:*"
  },
  "peerDependencies": {
    "cactus-react-native": "1.13.1",
    "react-native-nitro-modules": "^0.33.9"
  },
  "devDependencies": {
    "cactus-react-native": "1.13.1",
    "react-native-nitro-modules": "0.33.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larkxai/larkx.git",
    "directory": "packages/cactus"
  },
  "homepage": "https://github.com/larkxai/larkx/tree/main/packages/cactus#readme",
  "bugs": {
    "url": "https://github.com/larkxai/larkx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

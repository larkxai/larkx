{
  "name": "@larkxai/react-native",
  "version": "0.1.0",
  "description": "React Native adapter for the LarkX durable workflow engine.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./ownership": {
      "types": "./dist/ownership.d.ts",
      "import": "./dist/ownership.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@larkxai/core": "workspace:*",
    "@larkxai/protocol": "workspace:*",
    "@larkxai/storage-sqlite": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-crypto": "*",
    "expo-file-system": "*",
    "expo-network": "*",
    "expo-sqlite": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "expo": "58.0.26",
    "expo-crypto": "58.0.8",
    "expo-file-system": "58.0.14",
    "expo-network": "58.0.5",
    "expo-sqlite": "58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larkxai/larkx.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/larkxai/larkx/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/larkxai/larkx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

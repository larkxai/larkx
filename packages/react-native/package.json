{
  "name": "@larkxai/react-native",
  "version": "0.1.2",
  "description": "React Native SDK for the shared LarkX C++ runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "android",
    "cpp",
    "ios",
    "scripts",
    "vendor",
    "LarkXNativeCore.podspec",
    "react-native.config.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cactus": {
      "types": "./dist/cactus.d.ts",
      "react-native": "./dist/cactus.js",
      "import": "./dist/cactus.js",
      "default": "./dist/cactus.js"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/bundle-sdk-types.mjs dist/index.d.ts dist/cactus.d.ts",
    "prepack": "node scripts/vendor-native.mjs && node scripts/prepare-publish.mjs strip",
    "postpack": "node scripts/prepare-publish.mjs restore",
    "postinstall": "node scripts/vendor-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@larkxai/cactus": "workspace:*",
    "@larkxai/host": "workspace:*",
    "@larkxai/protocol": "workspace:*",
    "@types/react": "19.2.18",
    "expo": "58.0.26",
    "expo-file-system": "58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "tsup": "^9.0.0"
  },
  "peerDependencies": {
    "cactus-react-native": "1.13.1",
    "expo-file-system": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.33.9"
  },
  "peerDependenciesMeta": {
    "cactus-react-native": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larkxai/larkx.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/larkxai/larkx/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/larkxai/larkx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
